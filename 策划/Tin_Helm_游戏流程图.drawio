  <diagram id="tinhelm-flow" name="Tin Helm 流程图">
    <mxGraphModel dx="3423" dy="1852" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="3000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="A" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#284B63;fontColor=#FFFFFF;strokeColor=#16384D;strokeWidth=2;fontSize=14;" value="开始游戏" vertex="1">
          <mxGeometry height="60" width="220" x="900" y="40" as="geometry" />
        </mxCell>
        <mxCell id="B" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#284B63;fontColor=#FFFFFF;strokeColor=#16384D;strokeWidth=2;fontSize=14;" value="创建角色&lt;br&gt;种族+职业&lt;div&gt;&lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;i&gt;1.种族可以决定角色身材属性，职业可以决定角色用哪套卡组，可以获得什么专属道具，遗物。&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;i&gt;道具为一次性物品，遗物为全局加成，局外养成可以用符文。&lt;/i&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="220" x="900" y="140" as="geometry" />
        </mxCell>
        <mxCell id="RuoEVp9Gois10mRWCaiz-62" edge="1" parent="1" source="C" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="RuoEVp9Gois10mRWCaiz-26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="C" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#284B63;fontColor=#FFFFFF;strokeColor=#16384D;strokeWidth=2;fontSize=14;" value="设置初始资源&lt;br&gt;&lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;1.血量/卢恩（货币）/悔恨值/初始道具/初始遗物品&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="320" x="1210" y="165" as="geometry" />
        </mxCell>
        <mxCell id="E" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#284B63;fontColor=#FFFFFF;strokeColor=#16384D;strokeWidth=2;fontSize=14;" value="进入第 X 层&lt;br&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(255, 7, 48);&quot;&gt;1.生成两个（房间，命运，道路），暂定房间，房间类型（特殊事件，商人，篝火，宝箱，敌人，精英敌人）。A既定房间直接展示，B未知房间，玩家进入前无法知道里面内容&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(255, 7, 48);&quot;&gt;2.玩家多次选择未知房间（既定房间），会累积悔恨值，悔恨值高了，会导致在未知房间更容易遇见精英怪，或者特殊事件，如宝箱变成宝箱怪，遭遇战。更多挑战已经更多奖励。&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="385" x="805" y="590" as="geometry" />
        </mxCell>
