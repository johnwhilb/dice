        </mxCell>
        <mxCell id="HPLOSS" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;fontColor=#7A1F1F;strokeColor=#C95B5B;strokeWidth=2;fontSize=14;" value="世界崩坏：进入本次事件前先损失生命&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;固定值或最大生命百分比，建议全局统一公式&lt;/font&gt;" vertex="1">
