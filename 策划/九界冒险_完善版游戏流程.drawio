        <mxCell id="SKIP" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;fontColor=#7A1F1F;strokeColor=#C95B5B;strokeWidth=2;fontSize=14;" value="离开前检查当前预览事件&lt;br&gt;若是怪物/精英且未处理：&lt;br&gt;&lt;b&gt;加入该世界「未解决威胁池」，狂怒等级 +1&lt;/b&gt;" vertex="1">
