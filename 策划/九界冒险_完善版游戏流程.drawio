  <diagram id="nine-realms-flow" name="九界冒险-完整流程">
    <mxGraphModel dx="4454" dy="1111" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="3600" math="0" shadow="0">
