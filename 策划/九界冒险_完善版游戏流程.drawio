          <mxGeometry height="120" width="360" x="920" y="2620" as="geometry" />
        </mxCell>
        <mxCell id="BOSS" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;fontColor=#7A1F1F;strokeColor=#C95B5B;strokeWidth=2;fontSize=14;" value="下一次选择该世界的关键事件&lt;br&gt;&lt;b&gt;固定触发该界 Boss（第4个关键事件）&lt;/b&gt;" vertex="1">
          <mxGeometry height="95" width="520" x="1570" y="2632.5" as="geometry" />
        </mxCell>
        <mxCell id="WB" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;fontColor=#4B3B00;strokeColor=#D6B656;strokeWidth=2;fontSize=13;" value="击败世界 Boss？" vertex="1">
          <mxGeometry height="120" width="360" x="920" y="2800" as="geometry" />
        </mxCell>
        <mxCell id="ANCH" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFE8FA;fontColor=#45256B;strokeColor=#8E68B8;strokeWidth=2;fontSize=14;" value="获得该世界「界锚」&lt;br&gt;界锚 +1｜该世界稳定&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;稳定世界不再继续恶化；该界 Boss 不重复出现&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="540" x="500" y="2960" as="geometry" />
        </mxCell>
        <mxCell id="DAY" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1F8;fontColor=#1F2937;strokeColor=#5B8DB8;strokeWidth=2;fontSize=14;" value="Day + 1&lt;br&gt;根据新 Day 更新全局灾变阶段&lt;br&gt;返回主循环" vertex="1">
          <mxGeometry height="95" width="500" x="1090" y="2980" as="geometry" />
        </mxCell>
        <mxCell id="DEAD" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;fontColor=#4B3B00;strokeColor=#D6B656;strokeWidth=2;fontSize=13;" value="角色 HP &gt; 0？" vertex="1">
          <mxGeometry height="120" width="360" x="920" y="3150" as="geometry" />
        </mxCell>
        <mxCell id="LOSE" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE2E2;fontColor=#7F1D1D;strokeColor=#B91C1C;strokeWidth=3;fontSize=16;fontStyle=1;" value="失败&lt;br&gt;角色死亡 / Day 21 世界树主根断裂" vertex="1">
          <mxGeometry height="90" width="560" x="510" y="3320" as="geometry" />
        </mxCell>
        <mxCell id="ASG" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFE8FA;fontColor=#45256B;strokeColor=#8E68B8;strokeWidth=2;fontSize=14;" value="阿斯加德&lt;br&gt;三枚界锚完成三点定位，逆向追踪生命流&lt;br&gt;发现八界生命正被抽取至阿斯加德" vertex="1">
          <mxGeometry height="115" width="560" x="1700" y="980" as="geometry" />
        </mxCell>
        <mxCell id="ODIN" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;fontColor=#7A1F1F;strokeColor=#C95B5B;strokeWidth=2;fontSize=14;" value="最终 Boss：奥丁 / 世界树控制核心&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;他为延缓诸神黄昏，选择牺牲八界保存阿斯加德&lt;/font&gt;" vertex="1">
          <mxGeometry height="105" width="560" x="1700" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="FINAL" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;fontColor=#4B3B00;strokeColor=#D6B656;strokeWidth=2;fontSize=13;" value="击败最终 Boss？" vertex="1">
          <mxGeometry height="120" width="360" x="1800" y="1290" as="geometry" />
        </mxCell>
        <mxCell id="WIN" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF4E4;fontColor=#14532D;strokeColor=#2F855A;strokeWidth=3;fontSize=16;fontStyle=1;" value="游戏胜利&lt;br&gt;关闭抽取机制，决定九界之后的命运" vertex="1">
          <mxGeometry height="90" width="580" x="1690" y="1460" as="geometry" />
        </mxCell>
        <mxCell id="TIME" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;fontColor=#222222;strokeColor=#666666;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;20天灾变阶段&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Day 1–5｜征兆&lt;/b&gt;&lt;br&gt;规则正常，世界仍相对稳定。&lt;br&gt;&lt;br&gt;&lt;b&gt;Day 6–10｜狂野&lt;/b&gt;&lt;br&gt;怪物获得统一「狂野」修正；未解决威胁成长。&lt;br&gt;&lt;br&gt;&lt;b&gt;Day 11–15｜狂化&lt;/b&gt;&lt;br&gt;怪物获得更强通用词缀；威胁池优先级提高。&lt;br&gt;&lt;br&gt;&lt;b&gt;Day 16–20｜崩坏&lt;/b&gt;&lt;br&gt;每次进入事件先扣血；安全资源更紧张。&lt;br&gt;&lt;br&gt;&lt;b&gt;Day 21&lt;/b&gt;&lt;br&gt;世界树主根断裂，Run 失败。" vertex="1">
          <mxGeometry height="560" width="520" x="90" y="650" as="geometry" />
        </mxCell>
        <mxCell id="BOSSES" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;fontColor=#222222;strokeColor=#666666;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;八界与 Boss（建议）&lt;/b&gt;&lt;br&gt;&lt;br&gt;米德加尔特｜耶梦加得之影&lt;br&gt;约顿海姆｜乌特迦·洛基&lt;br&gt;穆斯贝尔海姆｜苏尔特尔化身&lt;br&gt;尼福尔海姆｜雾中无名者&lt;br&gt;赫尔海姆｜加姆&lt;br&gt;亚尔夫海姆｜失辉精灵王&lt;br&gt;华纳海姆｜古尔维格&lt;br&gt;尼达维勒｜法夫纳 / 锻造巨像&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;原则：每个 Boss 测试不同能力，而不是只做数值差异。&lt;/font&gt;" vertex="1">
          <mxGeometry height="500" width="520" x="90" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="RULES" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;fontColor=#222222;strokeColor=#666666;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;核心设计规则（控制制作量）&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. 世界差异优先做「规则修正」，少做专属事件树。&lt;br&gt;&lt;br&gt;2. 一个世界 = 3个关键事件 + 1个Boss；支援事件不计进度。&lt;br&gt;&lt;br&gt;3. 玩家不选择的怪物不会消失，而会进入威胁池并升级。&lt;br&gt;&lt;br&gt;4. 随机传送只随机「目的世界」，不额外随机复杂剧情结果。&lt;br&gt;&lt;br&gt;5. 三枚界锚即可去阿斯加德，因此一局不要求清完八界。&lt;br&gt;&lt;br&gt;6. 核心压力来自：时间、世界选择、延迟后果，而不是堆大量卡牌/事件。" vertex="1">
          <mxGeometry height="610" width="520" x="-50" y="1870" as="geometry" />
        </mxCell>
        <mxCell id="LORE" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;fontColor=#222222;strokeColor=#666666;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;剧情逻辑&lt;/b&gt;&lt;br&gt;&lt;br&gt;世界树根系正在断裂，跨界道路失去稳定坐标，因此传送不可指定。&lt;br&gt;&lt;br&gt;阿斯加德已被主动从主干切离；每个被稳定的世界会显露一枚「界锚」。&lt;br&gt;&lt;br&gt;三枚界锚形成三点定位，可逆向重建通往阿斯加德的临时路径。&lt;br&gt;&lt;br&gt;20天倒计时代表世界树从枯萎到主根彻底断裂的剩余时间。" vertex="1">
          <mxGeometry height="430" width="520" x="-140" y="2630" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="S" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" target="C">
