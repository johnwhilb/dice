        <mxCell id="KEY" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;fontColor=#4B3B00;strokeColor=#D6B656;strokeWidth=2;fontSize=13;" value="本次是否完成「世界关键事件」？" vertex="1">
          <mxGeometry height="120" width="360" x="920" y="2460" as="geometry" />
        </mxCell>
        <mxCell id="P1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1F8;fontColor=#1F2937;strokeColor=#5B8DB8;strokeWidth=2;fontSize=14;" value="该世界关键进度 +1&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;支援型事件（商人/篝火/宝箱）默认不推进进度&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="520" x="320" y="2635" as="geometry" />
