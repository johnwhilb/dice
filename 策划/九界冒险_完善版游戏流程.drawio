        </mxCell>
        <mxCell id="A3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4CC;fontColor=#4B3B00;strokeColor=#D6B656;strokeWidth=2;fontSize=13;" value="已收集 ≥ 3 枚界锚？" vertex="1">
