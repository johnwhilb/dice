        <mxCell id="EVENT" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1F8;fontColor=#1F2937;strokeColor=#5B8DB8;strokeWidth=2;fontSize=14;" value="结算本次事件&lt;br&gt;战斗 / 商店 / 篝火 / 宝箱 / 特殊事件" vertex="1">
