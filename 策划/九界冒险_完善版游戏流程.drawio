        <mxCell id="RIFT" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1F8;fontColor=#1F2937;strokeColor=#5B8DB8;strokeWidth=2;fontSize=14;" value="踏入世界裂隙&lt;br&gt;&lt;b&gt;目的地不可指定&lt;/b&gt;&lt;br&gt;随机前往其余世界之一" vertex="1">
