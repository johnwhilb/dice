        <mxCell id="GOA" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFE8FA;fontColor=#45256B;strokeColor=#8E68B8;strokeWidth=2;fontSize=14;" value="开启阿斯加德临时通路&lt;br&gt;&lt;b&gt;现在进入阿斯加德？&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;也可继续冒险，承担倒计时风险&lt;/font&gt;" vertex="1">
