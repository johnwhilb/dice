// Effect Syntax Guide: https://docs.cocos.com/creator/manual/zh/shader/index.html

CCEffect %{
  techniques:
  - passes:
    - vert: vs:vert
      frag: fs:frag
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
      depthStencilState:
        depthTest: false
        depthWrite: false
      rasterizerState:
        cullMode: none
      properties:
        mainColor:       { value: [1.0, 1.0, 1.0, 1.0], editor: { type: color } }

        # 六个骰子面的自定义图片。把 Texture / SpriteFrame 对应纹理拖到材质属性中。
        faceTexture1:    { value: white, editor: { displayName: "Face 1 / Front (+Z)" } }
        faceTexture2:    { value: white, editor: { displayName: "Face 2 / Right (+X)" } }
        faceTexture3:    { value: white, editor: { displayName: "Face 3 / Top (+Y)" } }
        faceTexture4:    { value: white, editor: { displayName: "Face 4 / Bottom (-Y)" } }
        faceTexture5:    { value: white, editor: { displayName: "Face 5 / Left (-X)" } }
        faceTexture6:    { value: white, editor: { displayName: "Face 6 / Back (-Z)" } }

        diceColor:       { value: [0.96, 0.96, 0.96, 1.0], editor: { type: color } }
        sideColor:       { value: [0.72, 0.75, 0.78, 1.0], editor: { type: color } }
        edgeColor:       { value: [0.12, 0.13, 0.14, 1.0], editor: { type: color } }
        outlineColor:    { value: [0.035, 0.040, 0.045, 1.0], editor: { type: color, displayName: "Illustration Outline" } }
        panelColor:      { value: [0.95, 0.96, 0.96, 1.0], editor: { type: color, displayName: "Face Panel Color" } }
        panelLineColor:  { value: [0.18, 0.20, 0.22, 1.0], editor: { type: color, displayName: "Face Panel Line" } }

        rotationSpeed:   { value: 1.0, editor: { range: [0.0, 5.0, 0.01] } }
        rotationX:       { value: 0.65, editor: { range: [-3.14, 3.14, 0.01] } }
        rotationY:       { value: 0.35, editor: { range: [-3.14, 3.14, 0.01] } }
        rotationZ:       { value: 0.0, editor: { range: [-3.14, 3.14, 0.01] } }
        stopFace:        { value: 1.0, editor: { range: [1.0, 6.0, 1.0] } }
        stopBlend:       { value: 0.0, editor: { range: [0.0, 1.0, 0.01] } }

        diceSize:        { value: 0.72, editor: { range: [0.2, 1.4, 0.01] } }
        cornerRoundness: { value: 0.035, editor: { range: [0.0, 0.12, 0.001] } }
        outlineWidth:    { value: 0.040, editor: { range: [0.0, 0.16, 0.001], displayName: "Outline Width" } }
        sideShade:       { value: 0.86, editor: { range: [0.45, 1.0, 0.01], displayName: "Side Tone" } }
        midShade:        { value: 0.94, editor: { range: [0.60, 1.0, 0.01], displayName: "Mid Tone" } }
        lineJitter:      { value: 0.010, editor: { range: [0.0, 0.08, 0.001], displayName: "Line Jitter" } }
        inkStrength:     { value: 0.78, editor: { range: [0.0, 1.0, 0.01], displayName: "Ink Strength" } }
        hatchStrength:   { value: 0.05, editor: { range: [0.0, 0.4, 0.01], displayName: "Hatch Strength" } }

        # 兼容旧材质参数；插画版不再使用真实光照/高光。
        lightStrength:   { value: 0.0, editor: { range: [0.0, 3.0, 0.01] } }
        shadowStrength:  { value: 0.0, editor: { range: [0.0, 1.0, 0.01] } }
        edgeGlow:        { value: 0.0, editor: { range: [0.0, 3.0, 0.01] } }

        aspect:          { value: 1.0, editor: { range: [0.2, 4.0, 0.01] } }
        alpha:           { value: 1.0, editor: { range: [0.0, 1.0, 0.01] } }
}%

CCProgram vs %{
  precision highp float;

  #include <builtin/uniforms/cc-global>

  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif

  in vec3 a_position;
  in vec2 a_texCoord;

  #if USE_LOCAL
    in vec4 a_color;
    out vec4 v_color;
  #endif

  out vec2 uv;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
      v_color = a_color;
    #endif

    pos = cc_matViewProj * pos;
    uv = a_texCoord;

    return pos;
  }
}%

CCProgram fs %{
  precision highp float;

  #include <builtin/uniforms/cc-global>
  #include <sprite-texture>

  in vec2 uv;

  #if USE_LOCAL
    in vec4 v_color;
  #endif

  // 六个面的材质纹理。sampler2D 不能放进 UBO。
  uniform sampler2D faceTexture1;
  uniform sampler2D faceTexture2;
  uniform sampler2D faceTexture3;
  uniform sampler2D faceTexture4;
  uniform sampler2D faceTexture5;
  uniform sampler2D faceTexture6;

  uniform UBO {
    vec4 mainColor;

    vec4 diceColor;
    vec4 sideColor;
    vec4 edgeColor;
    vec4 outlineColor;
    vec4 panelColor;
    vec4 panelLineColor;

    float rotationSpeed;
    float rotationX;
    float rotationY;
    float rotationZ;
    float stopFace;
    float stopBlend;
    


    float diceSize;
    float cornerRoundness;
    float outlineWidth;
    float sideShade;
    float midShade;
    float lineJitter;
    float inkStrength;
    float hatchStrength;

    float lightStrength;
    float shadowStrength;
    float edgeGlow;

    float aspect;
    float alpha;
  };

  #define PI 3.14159265359

  mat3 rotateX(float a) {
    float s = sin(a);
    float c = cos(a);

    return mat3(
      1.0, 0.0, 0.0,
      0.0, c, -s,
      0.0, s, c
    );
  }

  mat3 rotateY(float a) {
    float s = sin(a);
    float c = cos(a);

    return mat3(
      c, 0.0, s,
      0.0, 1.0, 0.0,
      -s, 0.0, c
    );
  }

  mat3 rotateZ(float a) {
    float s = sin(a);
    float c = cos(a);

    return mat3(
      c, -s, 0.0,
      s, c, 0.0,
      0.0, 0.0, 1.0
    );
  }

























 // ----------------------------------------------------------
  // 根据目标点数返回骰子最终旋转角度
  //
  // 当前面编号:
  //   前面 +Z = 1
  //   后面 -Z = 6
  //   右面 +X = 2
  //   左面 -X = 5
  //   上面 +Y = 3
  //   底面 -Y = 4
  // ----------------------------------------------------------

  vec3 getStopAngles(float face) {
    float halfPI = 1.57079632679;

    vec3 result = vec3(0.0, 0.0, 0.0);

    // 1 点：前面 +Z
    if (face < 1.5) {
      result = vec3(0.0, 0.0, 0.0);
    }

    // 2 点：右面 +X
    // 修正：由 -halfPI 改为 halfPI
    else if (face < 2.5) {
      result = vec3(0.0, halfPI, 0.0);
    }

    // 3 点：上面 +Y
    // 修正：由 halfPI 改为 -halfPI
    else if (face < 3.5) {
      result = vec3(-halfPI, 0.0, 0.0);
    }

    // 4 点：底面 -Y
    // 修正：由 -halfPI 改为 halfPI
    else if (face < 4.5) {
      result = vec3(halfPI, 0.0, 0.0);
    }

    // 5 点：左面 -X
    // 修正：由 halfPI 改为 -halfPI
    else if (face < 5.5) {
      result = vec3(0.0, -halfPI, 0.0);
    }


    // 6 点：后面 -Z
    else {
      result = vec3(0.0, PI, 0.0);
    }

    return result;
  }

  // GLSL ES 1.00 / WebGL 1 中通常没有 transpose(mat3)
// 对旋转矩阵而言，转置矩阵就是它的逆矩阵。
mat3 transposeMat3(mat3 m) {
  return mat3(
    m[0][0], m[1][0], m[2][0],
    m[0][1], m[1][1], m[2][1],
    m[0][2], m[1][2], m[2][2]
  );
}


  // 简单稳定噪声：用于模拟手绘线条的不规则抖动。
  float hash12(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
  }

  float noise2d(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);

    float a = hash12(i);
    float b = hash12(i + vec2(1.0, 0.0));
    float c = hash12(i + vec2(0.0, 1.0));
    float d = hash12(i + vec2(1.0, 1.0));

    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
  }

  float fbm2d(vec2 p) {
    float v = 0.0;
    float a = 0.5;
    v += noise2d(p) * a; p *= 2.03; a *= 0.5;
    v += noise2d(p) * a; p *= 2.01; a *= 0.5;
    v += noise2d(p) * a;
    return v;
  }

  // 根据当前面编号采样对应图片。
  vec4 sampleFaceTexture(vec2 faceTexUV, float faceValue) {
    if (faceValue < 1.5) {
      return texture(faceTexture1, faceTexUV);
    } else if (faceValue < 2.5) {
      return texture(faceTexture2, faceTexUV);
    } else if (faceValue < 3.5) {
      return texture(faceTexture3, faceTexUV);
    } else if (faceValue < 4.5) {
      return texture(faceTexture4, faceTexUV);
    } else if (faceValue < 5.5) {
      return texture(faceTexture5, faceTexUV);
    }

    return texture(faceTexture6, faceTexUV);
  }

  // 光线与立方体求交
  bool rayBox(
    vec3 rayOrigin,
    vec3 rayDir,
    vec3 boxSize,
    out float nearT,
    out float farT
  ) {
    vec3 invDir = 1.0 / rayDir;

    vec3 t0 = (-boxSize - rayOrigin) * invDir;
    vec3 t1 = ( boxSize - rayOrigin) * invDir;

    vec3 tMin = min(t0, t1);
    vec3 tMax = max(t0, t1);

    nearT = max(max(tMin.x, tMin.y), tMin.z);
    farT = min(min(tMax.x, tMax.y), tMax.z);

    return farT > max(nearT, 0.0);
  }

  // 根据局部空间中的命中点确定骰子面法线
  vec3 cubeNormal(vec3 p, vec3 halfSize) {
    vec3 d = abs(abs(p) - halfSize);

    if (d.x < d.y && d.x < d.z) {
      return vec3(sign(p.x), 0.0, 0.0);
    }

    if (d.y < d.z) {
      return vec3(0.0, sign(p.y), 0.0);
    }

    return vec3(0.0, 0.0, sign(p.z));
  }

  // 根据命中面计算面坐标和面编号
  void getFaceData(
    vec3 hitPoint,
    vec3 normal,
    out vec2 faceUV,
    out float faceValue
  ) {
    // 前面：1 点
    if (normal.z > 0.5) {
      faceUV = hitPoint.xy;
      faceValue = 1.0;
    }
    // 后面：6 点
    else if (normal.z < -0.5) {
      faceUV = vec2(-hitPoint.x, hitPoint.y);
      faceValue = 6.0;
    }
    // 右面：2 点
    else if (normal.x > 0.5) {
      faceUV = vec2(-hitPoint.z, hitPoint.y);
      faceValue = 2.0;
    }
    // 左面：5 点
    else if (normal.x < -0.5) {
      faceUV = vec2(hitPoint.z, hitPoint.y);
      faceValue = 5.0;
    }
    // 上面：3 点
    else if (normal.y > 0.5) {
      faceUV = vec2(hitPoint.x, -hitPoint.z);
      faceValue = 3.0;
    }
    // 底面：4 点
    else {
      faceUV = vec2(hitPoint.x, hitPoint.z);
      faceValue = 4.0;
    }
  }

  vec4 frag () {
    float time = cc_time.x;

    // 用原贴图 Alpha 裁剪特效区域。
    vec4 sourceTex = texture(cc_spriteTexture, uv);

    // 屏幕平面坐标。
    vec2 screenP = (uv - 0.5) * 2.0;
    screenP.x *= aspect;

    // ----------------------------------------------------------
    // 摄像机射线
    // ----------------------------------------------------------

    vec3 rayOrigin = vec3(0.0, 0.0, 2.8);
    vec3 rayDir = normalize(vec3(screenP, -1.85));

    // ----------------------------------------------------------
    // 骰子旋转
    // ----------------------------------------------------------

    float rotTime = time * rotationSpeed;

    // 正常旋转角度
    vec3 rollingAngles = vec3(
      rotationX + rotTime * 0.82,
      rotationY + rotTime * 1.10,
      rotationZ + rotTime * 0.48
    );

    // 目标点数对应的最终角度
    vec3 stopAngles = getStopAngles(stopFace);

    // 平滑停止进度
    float stopProgress = clamp(stopBlend, 0.0, 1.0);

    // smoothstep，让停止过程更自然
    stopProgress = stopProgress * stopProgress *
                   (3.0 - 2.0 * stopProgress);

    // 从滚动姿态过渡到目标面姿态
    vec3 finalAngles = mix(
      rollingAngles,
      stopAngles,
      stopProgress
    );

    float angleX = finalAngles.x;
    float angleY = finalAngles.y;
    float angleZ = finalAngles.z;

    mat3 rotation =
      rotateZ(angleZ) *
      rotateY(angleY) *
      rotateX(angleX);

    // 光线转换到骰子局部空间。








































    mat3 inverseRotation = transposeMat3(rotation);

    vec3 localRayOrigin = inverseRotation * rayOrigin;
    vec3 localRayDir = inverseRotation * rayDir;

    float halfDice = diceSize * 0.5;
    vec3 boxSize = vec3(halfDice);

    float nearT;
    float farT;

    bool hit = rayBox(
      localRayOrigin,
      localRayDir,
      boxSize,
      nearT,
      farT
    );

    if (!hit) {
      return vec4(0.0);
    }

    float hitT = nearT;

    if (hitT < 0.0) {
      hitT = farT;
    }

    vec3 hitPoint = localRayOrigin + localRayDir * hitT;

    vec3 localNormal = cubeNormal(hitPoint, boxSize);
    vec3 worldNormal = normalize(rotation * localNormal);

    // ----------------------------------------------------------
    // 骰子面数据
    // ----------------------------------------------------------

    vec2 faceUV;
    float faceValue;

    getFaceData(
      hitPoint / max(halfDice, 0.001),
      localNormal,
      faceUV,
      faceValue
    );

    // faceUV 范围大约为 -1 ~ 1，转换成纹理坐标 0 ~ 1。
    vec2 faceTexUV = clamp(faceUV * 0.5 + 0.5, 0.0, 1.0);
    vec4 faceTex = sampleFaceTexture(faceTexUV, faceValue);

    // ----------------------------------------------------------
    // 简单圆角 / 边缘高光
    // ----------------------------------------------------------

    float edgeDistance = min(
      min(abs(abs(hitPoint.x) - halfDice), abs(abs(hitPoint.y) - halfDice)),
      abs(abs(hitPoint.z) - halfDice)
    );

    float edgeMask = 1.0 - smoothstep(
      0.0,
      max(cornerRoundness, 0.001),
      edgeDistance
    );

    // ----------------------------------------------------------
    // UI 扁平贴纸版：去玻璃感、去材质感、像立绘卡片
    // ----------------------------------------------------------

    vec3 viewDir = normalize(rayOrigin - (rotation * hitPoint));
    float facing = clamp(dot(worldNormal, viewDir), 0.0, 1.0);

    // 只保留 very flat 的三档面明度，用于区分朝向，不模拟灯光。
    float frontBand = step(0.82, facing);
    float midBand   = step(0.52, facing);

    float faceTone = sideShade;
    faceTone = mix(faceTone, midShade, midBand);
    faceTone = mix(faceTone, 1.0, frontBand);

    // 每个骰子面先是一个不透明 UI 面板，避免透明 PNG 叠在立方体上产生“玻璃/塑料夹层感”。
    vec3 panelBase = panelColor.rgb * faceTone;

    // 做一个轻微内缩的面板区域，让它更像立绘卡片，而不是直接印在方块表面。
    float panelInset = 0.12;
    vec2 innerUV = abs(faceUV);
    float panelRegion = 1.0 - step(1.0 - panelInset, max(innerUV.x, innerUV.y));
    panelRegion = clamp(panelRegion, 0.0, 1.0);

    // 面板外仍然是骰子壳体，但非常克制，不做体积高光。
    vec3 shellColor = mix(sideColor.rgb, diceColor.rgb, midBand);
    shellColor = mix(shellColor, diceColor.rgb, frontBand);
    shellColor *= faceTone;

    vec3 color = mix(shellColor, panelBase, panelRegion);

    // 给内面板加一圈清晰但扁平的 UI 线框。
    float panelBorderDist = (1.0 - panelInset) - max(innerUV.x, innerUV.y);
    float panelLine = 1.0 - smoothstep(0.012, 0.024, panelBorderDist);
    panelLine *= panelRegion;
    color = mix(color, panelLineColor.rgb, panelLine * 0.90);

    // 贴图作为“印刷内容”放到面板里，而不是与底色半透明混合。
    // 稍微压实 alpha 边缘，减少半透明抗锯齿带来的玻璃感。
    float printAlpha = smoothstep(0.08, 0.30, faceTex.a);
    vec3 printedColor = faceTex.rgb * faceTone;

    // 弱化排线，避免 UI 场景里显脏。只保留极轻的线稿质感。
    vec2 hatchUV = faceUV * vec2(6.5, 6.5);
    float hatchNoise = fbm2d(hatchUV * 0.75 + vec2(faceValue * 2.17, faceValue * 1.31));
    float hatchLine = 1.0 - smoothstep(0.40, 0.48, abs(fract((hatchUV.x + hatchUV.y) * 0.42 + hatchNoise * 0.12) - 0.5));
    float hatchMask = hatchLine * (1.0 - frontBand) * 0.45;
    printedColor *= 1.0 - hatchMask * hatchStrength * 0.45;

    // 只在内面板里显示内容。透明区域显露 panelBase，而不是“空”或“玻璃底”。
    vec3 panelPrinted = mix(panelBase, printedColor, printAlpha);
    color = mix(color, panelPrinted, panelRegion);

    // 外轮廓：仍然保留一点手绘抖线，但强度降低，避免“奇怪抖动”。
    float borderDistance = 1.0 - max(abs(faceUV.x), abs(faceUV.y));
    float lineWidth = max(outlineWidth, 0.001);

    vec2 noiseUV = faceUV * 7.0 + vec2(faceValue * 3.11, faceValue * 1.73);
    float jitterNoise = fbm2d(noiseUV) - 0.5;
    float jitter = jitterNoise * lineJitter * 0.55;

    float borderMask = 1.0 - smoothstep(
      lineWidth + jitter,
      lineWidth * 1.55 + jitter,
      borderDistance
    );

    float inkNoise = noise2d(faceUV * 14.0 + vec2(faceValue * 4.2, faceValue * 2.6));
    float inkVariation = mix(0.90, 1.0, inkNoise);
    borderMask *= inkVariation;

    color = mix(color, outlineColor.rgb, borderMask * inkStrength * 0.92);

    // 仅保留很轻微的角部压暗，去掉任何“透明材质”错觉。
    float corner = max(abs(faceUV.x), abs(faceUV.y));
    float cornerMask = smoothstep(0.93, 1.0, corner) * (1.0 - borderMask);
    color *= 1.0 - cornerMask * 0.02;

    // ----------------------------------------------------------
    // Alpha
    // ----------------------------------------------------------

    float finalAlpha = alpha;

    // 如果承载 Sprite 为完整白色图，保持骰子完整显示。
    finalAlpha *= max(sourceTex.a, 0.001);

    vec4 outColor = vec4(color, finalAlpha);
    outColor *= mainColor;

    #if USE_LOCAL
      outColor *= v_color;
    #endif

    return outColor;
  }
}%
