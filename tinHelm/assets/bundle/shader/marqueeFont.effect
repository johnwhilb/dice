CCEffect %{
  techniques:
  - passes:
    - vert: marquee-font-vs:vert
      frag: marquee-font-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        speed: { value: 0.2, editor: { tooltip: '流光向右移动的速度（周期/秒）' } }
        repeatWidth: { value: 260.0, editor: { tooltip: '相邻流光之间的距离（UI 世界单位）', slide: true, range: [32.0, 1024.0], step: 1.0 } }
        bandWidth: { value: 0.28, editor: { tooltip: '流光宽度（占一个周期的比例）', slide: true, range: [0.01, 1.0], step: 0.01 } }
        softness: { value: 0.12, editor: { tooltip: '流光边缘柔和度（占一个周期的比例）', slide: true, range: [0.001, 0.5], step: 0.001 } }
        baseBrightness: { value: 0.35, editor: { tooltip: '未被流光扫过时的亮度', slide: true, range: [0.0, 1.0], step: 0.01 } }
        highlightColor: { value: [1.0, 1.0, 1.0, 1.0], editor: { type: color, tooltip: '流光颜色；Alpha 控制染色强度' } }
}%

CCProgram marquee-font-vs %{
  precision highp float;

  #include <builtin/uniforms/cc-global>

  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif

  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;
  out float marqueePosition;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    // BitmapFont 的 a_texCoord 指向字体图集中的单个字形，绝不能拿它做
    // fract/滚动，否则会采样到相邻字形。使用变换后的 UI 世界坐标让流光
    // 连续穿过整段 Label，也能跨越每个字形之间的 quad 边界。
    marqueePosition = pos.x;

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;

    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif

    color = a_color;
    return pos;
  }
}%

CCProgram marquee-font-fs %{
  precision highp float;

  #include <builtin/uniforms/cc-global>
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;
  in vec2 uv0;
  in float marqueePosition;

  uniform MarqueeFontParams {
    vec4 highlightColor;
    float speed;
    float repeatWidth;
    float bandWidth;
    float softness;
    float baseBrightness;
  };

  // cc_spriteTexture 由 Label 自动绑定为 BitmapFont 图集。Creator 3.8.x
  // 的内置 2D shader 使用 binding 12，使用 11 会导致部分后端采样失败。
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;

  vec4 frag () {
    // 字形本身始终用原始图集 UV 采样；跑马灯只改变最终颜色。
    vec4 glyph = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
    vec4 o = glyph * color;

    float safeRepeatWidth = max(repeatWidth, 0.0001);
    float phase = fract(marqueePosition / safeRepeatWidth - cc_time.x * speed);
    float distanceToCenter = abs(phase - 0.5);
    float halfBand = clamp(bandWidth, 0.0, 1.0) * 0.5;
    float edge = max(softness, 0.0001);
    float highlight = 1.0 - smoothstep(halfBand, halfBand + edge, distanceToCenter);

    float brightness = mix(clamp(baseBrightness, 0.0, 1.0), 1.0, highlight);
    vec3 litColor = o.rgb * brightness;
    vec3 tintedColor = litColor * highlightColor.rgb;
    o.rgb = mix(litColor, tintedColor, highlight * highlightColor.a);

    #if IS_GRAY
      float gray = dot(o.rgb, vec3(0.2126, 0.7152, 0.0722));
      o.rgb = vec3(gray);
    #endif

    ALPHA_TEST(o);
    return o;
  }
}%
