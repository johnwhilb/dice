CCEffect %{
  techniques:
  - passes:
    - vert: loading-background-vs:vert
      frag: loading-background-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
}%

CCProgram loading-background-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif

  in vec3 a_position;
  in vec4 a_color;
  out vec2 screenUv;
  out float opacity;

  vec4 vert () {
    vec4 position = vec4(a_position, 1.0);
    #if USE_LOCAL
      position = cc_matWorld * position;
    #endif
    vec4 clip = cc_matViewProj * position;
    screenUv = clip.xy / clip.w * 0.5 + 0.5;
    opacity = a_color.a;
    return clip;
  }
}%

CCProgram loading-background-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec2 screenUv;
  in float opacity;

  vec2 hash22 (vec2 cell) {
    vec3 value = fract(vec3(cell.xyx) * vec3(0.1031, 0.1030, 0.0973));
    value += dot(value, value.yzx + 33.33);
    return fract((value.xx + value.yz) * value.zy);
  }

  float ditherNoise (vec2 fragPos) {
    vec3 p3 = fract(vec3(fragPos.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z) - 0.5;
  }

  float nightStars (vec2 point, float density, vec2 drift, float time, float threshold) {
    vec2 field = point * density - drift * time;
    vec2 cellId = floor(field);
    vec2 seed = hash22(cellId);
    vec2 center = 0.24 + 0.52 * seed;
    vec2 delta = fract(field) - center;

    float dist = length(delta);
    float radius = mix(0.032, 0.072, seed.x);
    float core = 1.0 - smoothstep(radius * 0.35, radius * 1.45, dist);
    float halo = 1.0 - smoothstep(radius * 0.8, radius * 3.8, dist);
    float twinkle = 0.62 + 0.38 * sin(time * (0.75 + seed.y * 1.15) + seed.x * 37.0);
    return step(threshold, seed.y) * (core * 0.82 + halo * halo * 0.28) * twinkle;
  }

  vec4 frag () {
    float aspect = cc_screenSize.x / max(cc_screenSize.y, 1.0);
    vec2 uv = screenUv;
    vec2 point = (uv - 0.5) * vec2(aspect, 1.0);
    float time = cc_time.x;

    // 静谧深海夜蓝基底与柔和暗角
    float vignette = smoothstep(0.22, 1.08, length(point * vec2(0.76, 1.18)));
    vec3 color = mix(vec3(0.068, 0.086, 0.136), vec3(0.026, 0.035, 0.066), vignette);

    // 与主界面同源的极致干净微棋盘，轻缓漂移，无生硬线条
    vec2 tileDrift = mod(vec2(0.55, 0.24) * time * 0.065, vec2(2.0));
    vec2 tile = floor((point + vec2(0.015)) * 12.0 - tileDrift);
    float checker = mod(tile.x + tile.y, 2.0);
    color += checker * vec3(0.010, 0.013, 0.022) * (1.0 - vignette * 0.58);

    // 柔和水平舒展的夜空薄雾丝带（与主界面斜向极光错开构图）
    float mistWaveA = point.y - 0.08 - 0.09 * sin(point.x * 2.1 + time * 0.20)
      - 0.035 * cos(point.x * 4.4 - time * 0.28);
    float mistCloudA = exp(-7.2 * mistWaveA * mistWaveA);
    float mistSilkA = exp(-34.0 * (mistWaveA + 0.05) * (mistWaveA + 0.05));

    float mistWaveB = point.y + 0.12 + 0.08 * sin(point.x * 2.7 - time * 0.23 + 1.6)
      + 0.03 * sin(point.x * 5.2 + time * 0.31);
    float mistCloudB = exp(-8.5 * mistWaveB * mistWaveB);
    float mistSilkB = exp(-40.0 * (mistWaveB - 0.04) * (mistWaveB - 0.04));

    float ripple = 0.76 + 0.24 * sin(point.x * 5.6 - time * 0.36 + point.y * 3.0);
    vec3 ceruleanMist = vec3(0.036, 0.128, 0.188);
    vec3 twilightIndigo = vec3(0.072, 0.074, 0.184);
    vec3 mistToneA = mix(twilightIndigo, ceruleanMist, smoothstep(0.16, 0.84, uv.x));
    vec3 mistToneB = mix(ceruleanMist, twilightIndigo, smoothstep(0.18, 0.82, uv.x));

    // 底部进度条与文案区域柔光更克制，上方夜空更通透舒展
    float skyMask = mix(0.42, 1.0, smoothstep(0.14, 0.56, uv.y)) * (1.0 - vignette * 0.32);
    color += mistToneA * (mistCloudA * 0.38 + mistSilkA * ripple * 0.24) * skyMask;
    color += mistToneB * (mistCloudB * 0.28 + mistSilkB * (1.24 - ripple * 0.35) * 0.18) * skyMask;

    // 中上方的静谧夜空呼吸柔光云团
    float breath = 0.88 + 0.12 * sin(time * 0.62);
    vec2 centerCloud = (uv - vec2(0.50, 0.57)) * vec2(2.35, 2.75);
    color += vec3(0.030, 0.056, 0.094) * exp(-dot(centerCloud, centerCloud)) * breath;

    // 双层轻缓飘移的柔和星空微尘
    float farStars = nightStars(point, 50.0, vec2(0.18, 0.05), time, 0.81);
    float nearStars = nightStars(point + vec2(3.9, 2.1), 24.0, vec2(0.32, 0.09), time, 0.85);
    float starVis = mix(0.35, 1.0, smoothstep(0.16, 0.52, uv.y)) * (1.0 - vignette * 0.30);
    color += starVis * (
      farStars * vec3(0.18, 0.25, 0.38)
      + nearStars * vec3(0.28, 0.42, 0.56)
    );

    // 防暗部色带抖动
    color += ditherNoise(gl_FragCoord.xy) / 255.0;
    return vec4(max(color, vec3(0.0)), opacity);
  }
}%
