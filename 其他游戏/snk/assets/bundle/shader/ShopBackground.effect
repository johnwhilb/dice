CCEffect %{
  techniques:
  - passes:
    - vert: shop-background-vs:vert
      frag: shop-background-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
}%

CCProgram shop-background-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif

  in vec3 a_position;
  in vec4 a_color;
  out vec2 screenUv;
  out float opacity;

  vec4 vert () {
    vec4 position = vec4(a_position, 1.0);
    #if USE_LOCAL
      position = cc_matWorld * position;
    #endif
    vec4 clip = cc_matViewProj * position;
    screenUv = clip.xy / clip.w * 0.5 + 0.5;
    opacity = a_color.a;
    return clip;
  }
}%

CCProgram shop-background-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec2 screenUv;
  in float opacity;

  float cellSeed (vec2 cell) {
    vec3 seed = fract(vec3(cell.xyx) * vec3(0.1031, 0.1030, 0.0973));
    seed += dot(seed, seed.yzx + 33.33);
    return fract((seed.x + seed.y) * seed.z);
  }

  float driftingPixels (vec2 point, float cellSize, vec2 travel, float cycle, float trailLength) {
    vec2 field = point / cellSize - travel * cycle;
    float seed = cellSeed(mod(floor(field), travel));
    vec2 center = 0.41 + 0.25 * fract(seed * vec2(19.0, 37.0));
    vec2 delta = (fract(field) - center) * cellSize;
    float size = mix(0.46, 0.94, seed);
    float distance = max(abs(delta.x), abs(delta.y)) / 1.3;
    float square = 1.0 - smoothstep(size * 0.52, size + 0.35, distance);

    float behind = max(0.0, -delta.x);
    float trailHeight = abs(delta.y + floor(behind * travel.y / travel.x + 0.5));
    float trail = (1.0 - smoothstep(0.18, 0.78, trailHeight))
      * (1.0 - smoothstep(0.0, trailLength, behind)) * step(delta.x, 0.0);
    float pulse = 0.68 + 0.32 * sin(cycle * 25.1327412 + seed * 61.0);
    return step(0.81, seed) * max(square, trail * 0.52) * pulse;
  }

  vec4 frag () {
    float aspect = cc_screenSize.x / max(cc_screenSize.y, 1.0);
    vec2 point = (screenUv - 0.5) * vec2(aspect, 1.0);
    vec2 pixelPoint = (point + vec2(aspect, 1.0) * 0.5) * 270.0;
    vec2 grid = pixelPoint / 22.0;
    vec2 tile = floor(grid);
    float checker = mod(tile.x + tile.y, 2.0);

    float edge = smoothstep(0.34, 0.95, length(point * vec2(0.8, 1.38)));
    float brightness = mix(32.0, 47.0, screenUv.y) - edge * 7.0;
    brightness += checker * 3.5;

    vec2 gridEdge = min(fract(grid), 1.0 - fract(grid)) * 22.0;
    float seam = 1.0 - smoothstep(0.0, 0.76, min(gridEdge.x, gridEdge.y));
    brightness -= seam * 2.0;

    float cycle = mod(cc_time.x, 28.0) / 28.0;
    float openSpace = max(smoothstep(0.43, 0.78, screenUv.x), 1.0 - smoothstep(0.20, 0.51, screenUv.y));
    float contentShade = 1.0 - smoothstep(0.77, 1.0, screenUv.y) * 0.65;
    float activity = mix(0.23, 1.0, openSpace) * contentShade;

    float distant = driftingPixels(pixelPoint, 11.0, vec2(29.0, 9.0), cycle, 2.6);
    float close = driftingPixels(pixelPoint + vec2(41.0, 19.0), 19.0, vec2(23.0, 13.0), cycle, 5.4);
    brightness += distant * mix(5.0, 20.0, activity);
    brightness += close * activity * 24.0;
    return vec4(vec3(brightness / 255.0), opacity);
  }
}%
