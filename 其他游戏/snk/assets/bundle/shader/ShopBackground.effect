CCEffect %{
  techniques:
  - passes:
    - vert: shop-background-vs:vert
      frag: shop-background-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
}%

CCProgram shop-background-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif

  in vec3 a_position;
  in vec4 a_color;
  out vec2 screenUv;
  out float opacity;

  vec4 vert () {
    vec4 position = vec4(a_position, 1.0);
    #if USE_LOCAL
      position = cc_matWorld * position;
    #endif
    vec4 clip = cc_matViewProj * position;
    screenUv = clip.xy / clip.w * 0.5 + 0.5;
    opacity = a_color.a;
    return clip;
  }
}%

CCProgram shop-background-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec2 screenUv;
  in float opacity;

  vec4 frag () {
    float aspect = cc_screenSize.x / max(cc_screenSize.y, 1.0);
    vec2 point = vec2(screenUv.x * aspect, 1.0 - screenUv.y) * 270.0;
    vec2 tile = floor(point / 22.0);
    float checker = mod(tile.x + tile.y, 2.0);
    vec3 color = vec3(mix(48.0, 46.0, checker) / 255.0);
    color *= 1.0 - 0.3 * (1.0 - screenUv.y);
    return vec4(color, opacity);
  }
}%
