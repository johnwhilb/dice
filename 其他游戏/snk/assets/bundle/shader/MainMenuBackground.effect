CCEffect %{
  techniques:
  - passes:
    - vert: menu-background-vs:vert
      frag: menu-background-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
}%

CCProgram menu-background-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif

  in vec3 a_position;
  in vec4 a_color;
  out vec2 screenUv;
  out float opacity;

  vec4 vert () {
    vec4 position = vec4(a_position, 1.0);
    #if USE_LOCAL
      position = cc_matWorld * position;
    #endif
    vec4 clip = cc_matViewProj * position;
    screenUv = clip.xy / clip.w * 0.5 + 0.5;
    opacity = a_color.a;
    return clip;
  }
}%

CCProgram menu-background-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec2 screenUv;
  in float opacity;

  vec2 hashCell (vec2 cell) {
    vec3 value = fract(vec3(cell.xyx) * vec3(0.1031, 0.1030, 0.0973));
    value += dot(value, value.yzx + 33.33);
    return fract((value.xx + value.yz) * value.zy);
  }

  float starField (vec2 point, float density, float time, float speed, float fine) {
    vec2 field = point * density - vec2(1.0, 0.57) * time * speed;
    vec2 seed = hashCell(floor(field));
    vec2 center = 0.24 + 0.52 * seed;
    vec2 delta = (fract(field) - center) / 3.0;
    float radius = mix(0.025, 0.061, seed.x) * fine;
    float core = 1.0 - smoothstep(radius * 0.45, radius * 1.55, length(delta));
    float halo = 1.0 - smoothstep(0.025, 0.15, length(delta));
    float pulse = 0.68 + 0.32 * sin(time * (0.8 + seed.y) + seed.x * 31.0);
    return step(0.805, seed.y) * (core * 0.84 + halo * halo * 0.16) * pulse;
  }

  vec4 frag () {
    float aspect = cc_screenSize.x / max(cc_screenSize.y, 1.0);
    vec2 uv = screenUv;
    vec2 point = (uv - 0.5) * vec2(aspect, 1.0);
    float time = cc_time.x;

    float right = smoothstep(0.33, 0.78, uv.x);
    float edge = 1.0 - smoothstep(0.0, 0.22, min(uv.y, 1.0 - uv.y));
    float accent = max(right, edge * 0.50);
    float vignette = smoothstep(0.27, 0.98, length(point * vec2(0.80, 1.25)));
    vec2 gridOffset = mod(vec2(1.0, 0.57) * time * 0.006 * 12.0, vec2(2.0));
    vec2 tile = floor((point + vec2(0.019)) * 12.0 - gridOffset);
    float checker = mod(tile.x + tile.y, 2.0);
    vec3 color = mix(vec3(0.086, 0.091, 0.113), vec3(0.052, 0.054, 0.072), vignette);
    color += checker * vec3(0.016, 0.018, 0.026) * (1.0 - vignette * 0.55);

    float sweep = point.y - 0.14 * sin(point.x * 3.2 + time * 0.19) + 0.24 - point.x * 0.26;
    float haze = exp(-11.0 * sweep * sweep);
    float ribbon = exp(-54.0 * (sweep + 0.14) * (sweep + 0.14));
    float ripple = 0.67 + 0.33 * sin(point.x * 9.5 - time * 0.43 + point.y * 4.5);
    vec3 coolLight = mix(vec3(0.083, 0.038, 0.118), vec3(0.017, 0.111, 0.138), smoothstep(0.42, 0.95, uv.x));
    color += coolLight * (haze * 0.44 + ribbon * ripple * 0.28) * accent;
    vec2 bloomPoint = (uv - vec2(0.78, 0.56)) * vec2(4.2, 2.7);
    color += vec3(0.024, 0.025, 0.044) * exp(-dot(bloomPoint, bloomPoint));

    float distant = starField(point, 52.0, time, 0.65, 0.85);
    float close = starField(point + vec2(4.7, 2.3), 27.0, time, 0.83, 1.0);
    float visibility = mix(0.28, 1.0, accent) * (1.0 - 0.25 * vignette);
    color += visibility * (distant * vec3(0.18, 0.23, 0.33) + close * vec3(0.26, 0.31, 0.39));
    return vec4(color, opacity);
  }
}%
