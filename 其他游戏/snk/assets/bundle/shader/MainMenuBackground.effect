CCEffect %{
  techniques:
  - passes:
    - vert: menu-background-vs:vert
      frag: menu-background-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
}%

CCProgram menu-background-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif

  in vec3 a_position;
  in vec4 a_color;
  out vec2 screenUv;
  out float opacity;

  vec4 vert () {
    vec4 position = vec4(a_position, 1.0);
    #if USE_LOCAL
      position = cc_matWorld * position;
    #endif
    vec4 clip = cc_matViewProj * position;
    screenUv = clip.xy / clip.w * 0.5 + 0.5;
    opacity = a_color.a;
    return clip;
  }
}%

CCProgram menu-background-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec2 screenUv;
  in float opacity;

  vec2 hash22 (vec2 cell) {
    vec3 value = fract(vec3(cell.xyx) * vec3(0.1031, 0.1030, 0.0973));
    value += dot(value, value.yzx + 33.33);
    return fract((value.xx + value.yz) * value.zy);
  }

  float ditherNoise (vec2 fragPos) {
    vec3 p3 = fract(vec3(fragPos.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z) - 0.5;
  }

  float pixelMotes (vec2 point, float density, vec2 velocity, float time, float trailLen, float threshold) {
    vec2 field = point * density - velocity * time;
    vec2 cellId = floor(field);
    vec2 seed = hash22(cellId);
    vec2 center = 0.25 + 0.50 * seed;
    vec2 delta = fract(field) - center;

    // 干练的 SNKRX 像素方块粒子核
    float halfSize = mix(0.045, 0.095, seed.x);
    float squareDist = max(abs(delta.x), abs(delta.y));
    float core = 1.0 - smoothstep(halfSize * 0.55, halfSize + 0.04, squareDist);
    float halo = 1.0 - smoothstep(halfSize, halfSize + 0.22, length(delta));

    // 沿运动反方向拖出柔和像素尾迹
    vec2 dir = normalize(velocity);
    vec2 ortho = vec2(-dir.y, dir.x);
    float back = max(0.0, -dot(delta, dir));
    float side = abs(dot(delta, ortho));
    float trail = (1.0 - smoothstep(0.02, 0.08, side))
      * (1.0 - smoothstep(0.0, trailLen, back))
      * step(0.0, -dot(delta, dir));

    float pulse = 0.68 + 0.32 * sin(time * (0.9 + seed.y * 1.4) + seed.x * 37.0);
    return step(threshold, seed.y) * max(core, max(halo * halo * 0.26, trail * 0.44)) * pulse;
  }

  vec4 frag () {
    float aspect = cc_screenSize.x / max(cc_screenSize.y, 1.0);
    vec2 uv = screenUv;
    vec2 point = (uv - 0.5) * vec2(aspect, 1.0);
    float time = cc_time.x;

    // 右侧与边缘开阔区更绚丽，左侧按钮区保持沉稳高对比
    float rightZone = smoothstep(0.24, 0.74, uv.x);
    float verticalEdge = 1.0 - smoothstep(0.0, 0.24, min(uv.y, 1.0 - uv.y));
    float openMask = max(rightZone, verticalEdge * 0.45);
    float vignette = smoothstep(0.24, 1.04, length(point * vec2(0.76, 1.18)));

    // 深邃黑曜紫基底
    vec3 color = mix(vec3(0.072, 0.078, 0.118), vec3(0.032, 0.034, 0.056), vignette);

    // 缓慢斜向飘移的像素格纹地板与微光缝隙
    vec2 drift = mod(vec2(1.0, 0.52) * time * 0.072, vec2(2.0));
    vec2 gridCoord = (point + vec2(0.02)) * 12.5 - drift;
    vec2 tile = floor(gridCoord);
    float checker = mod(tile.x + tile.y, 2.0);
    vec2 cellEdge = min(fract(gridCoord), 1.0 - fract(gridCoord));
    float seam = 1.0 - smoothstep(0.0, 0.048, min(cellEdge.x, cellEdge.y));
    color += checker * vec3(0.012, 0.014, 0.024) * (1.0 - vignette * 0.52);
    color -= seam * vec3(0.010, 0.011, 0.016) * (1.0 - vignette * 0.4);

    // 双层流动霓虹极光丝带（电光紫 <-> 冰川青）
    float waveA = point.y - 0.15 * sin(point.x * 2.8 + time * 0.24)
      - 0.055 * cos(point.x * 5.6 - time * 0.36) + 0.18 - point.x * 0.27;
    float curtainA = exp(-7.5 * waveA * waveA);
    float filamentA = exp(-48.0 * (waveA + 0.07) * (waveA + 0.07));

    float waveB = point.y + 0.12 * sin(point.x * 3.5 - time * 0.29 + 1.4)
      + 0.04 * sin(point.x * 7.2 + time * 0.42) - 0.14 - point.x * 0.19;
    float curtainB = exp(-9.5 * waveB * waveB);
    float filamentB = exp(-58.0 * (waveB - 0.05) * (waveB - 0.05));

    float shimmer = 0.72 + 0.28 * sin(point.x * 8.4 - time * 0.52 + point.y * 4.2);
    vec3 violetTone = vec3(0.145, 0.052, 0.215);
    vec3 cyanTone = vec3(0.022, 0.175, 0.215);
    vec3 auroraGrad = mix(violetTone, cyanTone, smoothstep(0.32, 0.94, uv.x));
    vec3 auroraAlt = mix(cyanTone, violetTone, smoothstep(0.25, 0.88, uv.y));

    float auroraLight = (curtainA * 0.42 + filamentA * shimmer * 0.34) * openMask;
    float auroraSecondary = (curtainB * 0.30 + filamentB * (1.28 - shimmer * 0.4) * 0.24) * openMask;
    color += auroraGrad * auroraLight + auroraAlt * auroraSecondary;

    // 极光微弱照亮地板接缝，形成霓虹反光质感
    float seamGlint = seam * (curtainA + curtainB * 0.75) * openMask;
    color += mix(vec3(0.11, 0.07, 0.22), vec3(0.04, 0.18, 0.24), uv.x) * seamGlint * 0.32;

    // 右侧演示蛇活动区的柔和深空辉光
    vec2 focusDelta = (uv - vec2(0.73, 0.52)) * vec2(3.1, 2.3);
    color += vec3(0.030, 0.036, 0.068) * exp(-dot(focusDelta, focusDelta));

    // 三层视差星尘与像素流光粒子
    float farDust = pixelMotes(point, 54.0, vec2(0.38, 0.20), time, 0.06, 0.82);
    float midMotes = pixelMotes(point + vec2(3.1, 1.7), 27.0, vec2(0.62, 0.33), time, 0.18, 0.83);
    float nearMotes = pixelMotes(point + vec2(7.4, 5.2), 14.5, vec2(0.95, 0.50), time, 0.30, 0.89);

    float dustVis = mix(0.26, 1.0, openMask) * (1.0 - 0.22 * vignette);
    vec3 nearTint = mix(vec3(0.42, 0.32, 0.64), vec3(0.24, 0.56, 0.66), smoothstep(0.35, 0.88, uv.x));
    color += dustVis * (
      farDust * vec3(0.18, 0.23, 0.35)
      + midMotes * vec3(0.28, 0.36, 0.50)
      + nearMotes * nearTint
    );

    // 防暗部色带抖动
    color += ditherNoise(gl_FragCoord.xy) / 255.0;
    return vec4(max(color, vec3(0.0)), opacity);
  }
}%
